    "e2e": "pnpm --filter demo e2e",
    "check:colors": "node scripts/check-colors.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
