{
  "name": "@typomd/react",
  "version": "1.0.0",
  "description": "React WYSIWYG Markdown editor: toolbar, floating selection bar, slash menu. Typora-like editing with GFM, math, Mermaid, and Shiki.",
  "keywords": ["markdown", "wysiwyg", "editor", "react", "typora", "prosemirror", "milkdown", "slash-commands"],
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/typomd/",
  "bugs": { "url": "https://github.com/ximing/typomd/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/typomd.git",
    "directory": "packages/react"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup && cat src/styles/base.css src/styles/toolbar.css src/styles/floating.css src/styles/slash.css > dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@typomd/core": "workspace:*",
    "@typomd/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
