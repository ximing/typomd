{
  "name": "@typomd/core",
  "version": "1.0.0",
  "description": "Headless Typora-like WYSIWYG Markdown editor core (Milkdown/ProseMirror). Markdown is the only source of truth.",
  "keywords": ["markdown", "wysiwyg", "editor", "prosemirror", "milkdown", "typora", "headless"],
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/typomd/",
  "bugs": { "url": "https://github.com/ximing/typomd/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/typomd.git",
    "directory": "packages/core"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@milkdown/core": "catalog:",
    "@milkdown/ctx": "catalog:",
    "@milkdown/prose": "catalog:",
    "@milkdown/transformer": "catalog:",
    "@milkdown/utils": "catalog:",
    "@milkdown/preset-commonmark": "catalog:",
    "@milkdown/preset-gfm": "catalog:",
    "@milkdown/plugin-listener": "catalog:",
    "@milkdown/plugin-history": "catalog:",
    "katex": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:",
    "remark-math": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@types/katex": "^0.16.7",
    "@types/unist": "catalog:",
    "@types/node": "catalog:"
  }
}
